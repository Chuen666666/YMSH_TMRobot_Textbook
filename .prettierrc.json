{
    "$schema": "https://json.schemastore.org/prettierrc",
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 120,
    "singleQuote": true,
    "semi": true,
    "bracketSpacing": false,
    "trailingComma": "none",
    "arrowParens": "always",
    "overrides": [
        { "files": "*.md", "options": { "proseWrap": "preserve", "tabWidth": 2 } },
        {
            "files": ["*.json", "*.jsonc"],
            "options": { "tabWidth": 4, "bracketSpacing": true, "objectWrap": "collapse", "trailingComma": "none" }
        },
        { "files": ["*.yml", "*.yaml"], "options": { "tabWidth": 2 } },
        { "files": "*.vue", "options": { "tabWidth": 2 } }
    ]
}
