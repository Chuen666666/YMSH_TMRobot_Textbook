{
    "config": {
        "default": true,
        "MD001": true,
        "MD007": { "indent": 2 },
        "MD013": false,
        "MD022": true,
        "MD024": false,
        "MD025": { "front_matter_title": "" },
        "MD026": false,
        "MD031": true,
        "MD033": false,
        "MD034": true,
        "MD041": false,
        "MD049": { "style": "asterisk" },
        "MD055": { "style": "leading_and_trailing" },
        "MD056": false
    },
    "globs": ["docs/**/*.md", "README.md", "AGENTS.md"],
    "ignores": ["node_modules/**", "docs/.vitepress/cache/**", "docs/.vitepress/dist/**"]
}
