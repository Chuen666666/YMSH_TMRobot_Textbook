{
    "name": "tmrobot",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "check": "npm run lint:md && npm run validate:names && npm run format:check && npm run docs:build",
        "lint:md": "markdownlint-cli2",
        "validate:names": "node scripts/validate-name-translations.js",
        "format:md": "markdownlint-cli2 --fix && prettier --write \"docs/**/*.md\" \"*.md\"",
        "format:md:check": "prettier --check \"docs/**/*.md\" \"*.md\"",
        "format": "markdownlint-cli2 --fix && prettier --write \"**/*.{md,js,ts,mts,vue,json,jsonc,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{md,js,ts,mts,vue,json,jsonc,yml,yaml}\"",
        "pwa:assets": "pwa-assets-generator",
        "docs:dev": "cd docs && vitepress dev .",
        "docs:build": "cd docs && vitepress build .",
        "docs:preview": "cd docs && vitepress preview ."
    },
    "engines": {
        "node": ">=22.14.0"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@types/node": "26.6.6",
        "@vite-pwa/assets-generator": "2.0.0",
        "@vite-pwa/vitepress": "2.0.3",
        "ajv": "8.20.0",
        "magicast": "0.5.5",
        "markdownlint-cli2": "0.24.0",
        "prettier": "3.9.10",
        "rolldown": "1.3.1",
        "vitepress": "^1.6.4",
        "vue": "3.5.45"
    },
    "overrides": {
        "katex": "0.18.2",
        "re2js": "2.8.7"
    },
    "allowScripts": {
        "esbuild@0.21.5": true
    }
}
